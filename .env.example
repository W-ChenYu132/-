# ---------- 服务端口 ----------
PORT=3000

# ---------- 数据目录（数据库文件与上传附件都在这里） ----------
# 不填则使用项目下的 ./data
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# ---------- 会话签名密钥 ----------
# 不填会自动生成并保存在 data/secret.key；生产环境建议显式设置，至少 32 位
# SESSION_SECRET=change-me-to-a-random-32-chars-string

# ---------- 首次启动创建的管理员 ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456
ADMIN_NAME=系统管理员

# ---------- 演示数据 ----------
# 1 = 首次启动创建演示班级/学生/作业；0 = 只创建管理员
SEED_DEMO=1

# ---------- 学生自助注册 ----------
# 1 = 允许注册（登录后管理员也可在「系统设置」里关闭）；0 = 完全禁止
ALLOW_REGISTER=1

# ---------- 上传限制 ----------
MAX_UPLOAD_MB=20
